[Unit]
Description=homelab-status (public, read-only status endpoint)
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 -I /opt/homelab-status/homelab_status.py
EnvironmentFile=-/etc/homelab-status.env
Restart=on-failure
RestartSec=5

# No privileges, no writable files, nothing it does not need.
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
MemoryMax=96M
TasksMax=64

[Install]
WantedBy=multi-user.target
